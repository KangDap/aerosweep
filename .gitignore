# ==============================================================================
# AeroSweep — .gitignore
# ==============================================================================

# Dataset mentah (citra UAV asli + COCO JSON)
data/vision/raw/images/
data/vision/raw/*.tar.gz
data/vision/raw/*.zip

# BOLEH di-push (file kecil, penting untuk reproduktibilitas)
# data/vision/raw/dronewaste_v1.0.json  ← uncomment jika mau exclude

# Hasil preprocessing (patch 512x512) — bisa di-generate ulang
data/vision/processed/
data/tabular/

# Grid testing
data/vision/test_grids/


# ------------------------------------------------------------------------------
# 2. MODEL WEIGHTS — File besar, jangan push ke GitHub
# ------------------------------------------------------------------------------

# Semua file bobot model
*.pt
*.pth
*.onnx
*.engine
*.tflite

# Folder hasil training Ultralytics
models/nn_weights/
models/fuzzy_params/


# ------------------------------------------------------------------------------
# 3. OUTPUT — Di-generate ulang, tidak perlu di-push
# ------------------------------------------------------------------------------

# File CSV output (tim Fuzzy ambil dari pipeline, bukan dari Git)
outputs/output_fitur_ann_ke_fuzzy.csv
outputs/output_fuzzy_results.csv
outputs/annotated_grids/

# File gambar visualisasi (di-generate ulang dari notebook)
outputs/figures/
outputs/*.png
outputs/*.jpg

# Log files
outputs/*.log
outputs/training_summary.txt


# ------------------------------------------------------------------------------
# 4. PYTHON
# ------------------------------------------------------------------------------

# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class
*.pyo

# Virtual environment
venv/
env/
.env/
.venv/
ENV/

# Distribution / packaging
dist/
build/
*.egg-info/
*.egg
.eggs/

# pytest
.pytest_cache/
.coverage
htmlcov/

# mypy
.mypy_cache/


# ------------------------------------------------------------------------------
# 5. JUPYTER NOTEBOOK
# ------------------------------------------------------------------------------

# Output sel notebook (jangan push hasil run)
.ipynb_checkpoints/

# Notebook dengan output besar (uncomment jika perlu)
# notebooks/*.ipynb


# ------------------------------------------------------------------------------
# 6. IDE & EDITOR
# ------------------------------------------------------------------------------

# VSCode
.vscode/
*.code-workspace

# PyCharm / IntelliJ
.idea/
*.iml

# Spyder
.spyderproject.cfg
.spyproject/

# Vim / Emacs
*.swp
*.swo
*~


# ------------------------------------------------------------------------------
# 7. OS
# ------------------------------------------------------------------------------

# Windows
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/

# macOS
.DS_Store
.AppleDouble
.LSOverride

# Linux
*~


# ------------------------------------------------------------------------------
# 8. ENVIRONMENT VARIABLES — JANGAN PUSH API KEY / CREDENTIAL
# ------------------------------------------------------------------------------
.env
.env.local
.env.*.local
secrets.yaml
credentials.json


# ------------------------------------------------------------------------------
# 9. ULTRALYTICS CACHE
# ------------------------------------------------------------------------------
runs/
ultralytics/